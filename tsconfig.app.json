{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "noEmit": true,
    "composite": true
  },
  /*
   * `relay/src/auth.ts` is named explicitly, not by directory. The relay is a
   * separate package with its own tsconfig and its own dependencies, and the
   * app must build with that directory deleted — but its authorization rules
   * are dependency-free on purpose so this project can typecheck and test them
   * (test/relayAuth.test.ts). Naming the one file keeps the relay's server, and
   * therefore `ws` and `@y/websocket-server`, out of the app's program.
   */
  "include": ["src", "private", "test", "relay/src/auth.ts", "wasm/journal-seal/seal.generated.ts"]
}
