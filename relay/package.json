{
  "name": "done-relay",
  "version": "0.1.0",
  "private": true,
  "description": "A dumb pipe carrying Yjs updates between one person's devices. Optional by design.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/server.js",
    "dev": "tsc -b && node dist/server.js",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test 'test/*.test.mjs'",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@y/websocket-server": "0.1.1",
    "ws": "^8.18.3",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "y-websocket": "3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
