+  if (typeof v === 'string') return (v[0] === 'a' ? 'b' : 'a') + v.slice(1);
+  throw Error('Unsupported mutation');
+}
+export function paths(v, p = []) {
+  if (
+    v instanceof Uint8Array ||
+    v === null ||
+    typeof v !== 'object' ||
