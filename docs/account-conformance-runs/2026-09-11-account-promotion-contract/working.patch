+const bindingBody = (p) => ({
+  v: p.v,
+  kind: p.kind,
+  requestDigest: p.requestDigest,
+  epochHead: p.epochHead,
+  stored: {
+    binding: Object.fromEntries(
+      ['v', 'accountId', 'principalId', 'rpId', 'epoch', 'credId', 'publicKey'].map((k) => [
+        k,
+        p.stored.binding[k],
+      ]),
+    ),
+    bindingSignature: p.stored.bindingSignature,
+  },
+});
+export function payload(r) {
+  const a = [
+    'done/local-promotion/v1',
+    r.v,
+    r.kind,
+    r.id,
+    [
+      'slotId',
+      'principalId',
+      'workspaceId',
+      'storeId',
+      'rootId',
+      'genesisIntentId',
+      'generation',
+    ].map((k) => r.source[k]),
+    r.claimMac,
+    ['v', 'serviceId', 'origin', 'rpId', 'authRoot'].map((k) => r.pin[k]),
+    JSON.stringify(pendingBody(r.account)),
+    r.retryHash,
+    r.custodyMac,
+    r.sealReserved,
+    r.credentialIds,
+    r.stage,
+    r.credentials?.map((c) => [
+      c.role,
+      c.id,
+      hex(c.publicKey),
+      c.sealed.v,
+      hex(c.sealed.nonce),
+      hex(c.sealed.ct),
