+    'docs/selections/row-5-finalization.md',
+    'docs/selections/row-7-checkpoint.md',
+    'docs/selections/row-14-recovery-code.md',
+    ...['S0-1/A-policies.md', ...[2, 3, 4, 5, 6, 7].map((n) => `S0-${n}/A-schemas.md`)].map(
+      (p) => 'docs/review/remediation/' + p,
