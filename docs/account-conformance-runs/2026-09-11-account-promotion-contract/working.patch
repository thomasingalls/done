+            role: i === 0 ? 'wrapping' : 'signing',
+            id,
+            publicKey: bytes((i === 0 ? '90' : '91').repeat(32)),
+            sealed: {
+              v: 2,
+              nonce: bytes((i === 0 ? '92' : '93').repeat(12)),
+              ct: bytes((i === 0 ? '94' : '95').repeat(48)),
+            },
+          })),
+    mac: new Uint8Array(32),
