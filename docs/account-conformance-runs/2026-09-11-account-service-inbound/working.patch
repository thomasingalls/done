+++ b/test/account-service-inbound/generated.test.mjs
@@ -0,0 +1,114 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fc from 'fast-check';
+import { writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { ready, inventory, mutate } from '../account-service-delivery/fixtures.mjs';
+import { query, read, pageProof } from './oracle.mjs';
+
+test(
+  '60 generated append/read/restart/replay/role/ledger histories preserve original prefixes',
+  { timeout: 90000 },
+  async () => {
+    const seed = 9112031,
+      histories = [],
+      coverage = {};
+    const save = (status, details) => {
+      if (process.env.ACCOUNT_REPORT_DIR)
+        writeFileSync(
+          join(process.env.ACCOUNT_REPORT_DIR, 'generated.json'),
+          JSON.stringify({ seed, status, coverage, histories, details }, null, 2) + '\n',
+        );
+    };
+    const property = fc.asyncProperty(
+      fc.array(
+        fc.record({
+          op: fc.constantFrom(
+            'append',
+            'read',
+            'restart',
+            'replay',
+            'reader',
+            'publisher',
+            'ledger',
+          ),
+          limit: fc.integer({ min: 1, max: 8 }),
+          cursor: fc.nat(20),
+        }),
+        { minLength: 4, maxLength: 14 },
+      ),
+      async (commands) => {
+        // Each generated case owns and promptly closes its resources, including a failing case.
+        const cleanup = [],
+          scope = { after: (f) => cleanup.push(f) };
+        histories.push(commands);
+        save('running');
+        try {
+          const x = await ready(scope),
+            retained = [];
+          let saved;
+          for (const c of commands) {
+            coverage[c.op] = (coverage[c.op] ?? 0) + 1;
+            if (c.op === 'append') {
+              const w = x.make(retained.length + 1, 'authored-' + retained.length),
+                r = await x.call(w);
+              assert.equal(r.kind, 'decision');
+              retained.push({ w, r });
+              continue;
+            }
+            if (c.op === 'restart') {
+              x.f.restart();
+              x.authority.restart();
+              continue;
+            }
+            const after = c.cursor % (retained.length + 1),
+              q = c.op === 'replay' && saved ? saved : query(x, after, c.limit);
+            const before = inventory(x);
+            if (c.op === 'reader' || c.op === 'publisher') {
+              assert.equal(
+                (await read(x, query(x, after, c.limit, { [c.op]: 'ac'.repeat(16) }))).kind,
+                'unknown',
+              );
+            } else if (c.op === 'ledger' && retained.length) {
+              const ordinal = x.f.rows('delivery_decisions').at(-1).ordinal;
+              mutate(x, (db) =>
+                db
+                  .prepare('UPDATE delivery_decisions SET ordinal=? WHERE ordinal=?')
+                  .run(ordinal + 1, ordinal),
+              );
+              assert.equal((await read(x, q)).kind, 'unknown');
+              mutate(x, (db) =>
+                db
+                  .prepare('UPDATE delivery_decisions SET ordinal=? WHERE ordinal=?')
+                  .run(ordinal, ordinal + 1),
+              );
+            } else {
+              pageProof(await read(x, q), q, x, retained);
+              saved = q;
+            }
+            assert.equal(inventory(x), before);
+          }
+          let after = 0;
+          do {
+            const q = query(x, after, 1);
+            after = pageProof(await read(x, q), q, x, retained).next;
+          } while (after < retained.length);
+        } finally {
+          for (const close of cleanup.reverse()) await close();
+        }
+      },
+    );
+    const result = await fc.check(property, { seed, numRuns: 60, endOnFailure: true });
+    save(result.failed ? 'failed' : 'passed', {
+      failed: result.failed,
+      numRuns: result.numRuns,
+      numShrinks: result.numShrinks,
+      counterexample: result.counterexample,
+      counterexamplePath: result.counterexamplePath,
+      error: result.errorInstance ? String(result.errorInstance.stack) : null,
+    });
+    assert.equal(result.failed, false, String(result.errorInstance?.stack));
+    for (const op of ['append', 'read', 'restart', 'replay', 'reader', 'publisher', 'ledger'])
+      assert.ok(coverage[op] > 0, 'Missing generated coverage: ' + op);
+  },
+);
diff --git a/test/account-service-inbound/native.test.mjs b/test/account-service-inbound/native.test.mjs
new file mode 100644
index 0000000..94e21b6
--- /dev/null
+++ b/test/account-service-inbound/native.test.mjs
@@ -0,0 +1,97 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  native,
+  selected,
+  openReceive,
+  closeReceive,
+  request,
+  receive,
+  status,
+  open,
+  close,
+  edit,
+  prepare,
+  submission,
+  cold,
+} from '../account-receive/fixtures.mjs';
+import { decodeInboundPage } from '../../account-protocol/inboundTransport.ts';
+import { envelope } from '../account-transport/oracle.mjs';
+
+test(
+  'owned browser request consumes original service v2 pages over HTTP and cold-replays them',
+  { timeout: 60000 },
+  async (t) => {
+    const f = await native(t),
+      item = await selected(f, 'service-inbound-http');
+    await open(f.page, item);
+    await edit(f.page, 0, 0, 'v2 HTTP retained writing ');
+    const originals = [];
+    for (let position = 1; position <= 2; position++) {
+      await prepare(f.page);
+      const w = await submission(f.page, position);
+      originals.push(w);
+      const r = await f.page.evaluate((token) => opened.submitPending(token), f.testOperatorToken);
+      assert.equal(r.kind, 'accepted');
+    }
+    await close(f.page);
+    const send = async (q, path = '/account/delivery/read-v2', headers = {}) => {
+      const r = await fetch(f.server.origin + path, {
+        method: 'POST',
+        headers: {
+          Origin: f.server.origin,
+          'Content-Type': 'application/octet-stream',
+          Authorization: 'Bearer ' + f.testOperatorToken,
+          ...headers,
+        },
+        body: new Uint8Array(q),
+      });
+      return {
+        status: r.status,
+        cache: r.headers.get('cache-control'),
+        type: r.headers.get('content-type'),
+        bytes: new Uint8Array(await r.arrayBuffer()),
+      };
+    };
+    await openReceive(f.page, item);
+    let q = await request(f.page);
+    assert.equal((await send(q, '/account/delivery/read')).status, 409);
+    for (const headers of [
+      { Origin: 'https://foreign.test' },
+      { 'Content-Type': 'application/json' },
+      { Authorization: 'Bearer ' + 'B'.repeat(43) },
+    ])
+      assert.equal((await send(q, undefined, headers)).status, 403);
+    assert.equal((await send(new Uint8Array(4097))).status, 413);
+    const forged = JSON.parse(Buffer.from(q).toString());
+    forged[14] = '00'.repeat(64);
+    assert.equal((await send(Buffer.from(JSON.stringify(forged)))).status, 409);
+    let saved;
+    for (let position = 1; position <= 2; position++) {
+      q = await request(f.page);
+      const r = await send(q);
+      assert.equal(r.status, 200);
+      assert.equal(r.cache, 'no-store');
+      assert.equal(r.type, 'application/octet-stream');
+      const p = decodeInboundPage(r.bytes);
+      assert.deepEqual(Buffer.from(p.entries[0].envelope), envelope(originals[position - 1]));
+      assert.equal(p.through, 2);
+      assert.equal(p.next, position);
+      assert.equal(p.entries.length, 1);
+      // Lost HTTP response adds no service state; exact replay returns the same signed bytes.
+      assert.deepEqual((await send(q)).bytes, r.bytes);
+      assert.equal((await receive(f.page, r.bytes)).kind, 'received');
+      saved = r.bytes;
+    }
+    assert.equal((await receive(f.page, saved)).kind, 'duplicate');
+    assert.equal((await status(f.page)).receivedThrough, 2);
+    await closeReceive(f.page);
+    await cold(f);
+    await openReceive(f.page, item);
+    assert.equal((await status(f.page)).receivedThrough, 2);
+    q = await request(f.page);
+    const end = await send(q);
+    assert.equal((await receive(f.page, end.bytes)).kind, 'empty');
+    await closeReceive(f.page);
+  },
+);
diff --git a/test/account-service-inbound/oracle.mjs b/test/account-service-inbound/oracle.mjs
new file mode 100644
index 0000000..f302757
--- /dev/null
+++ b/test/account-service-inbound/oracle.mjs
@@ -0,0 +1,63 @@
+/** Independent Node framing and verification: no production v2 encoder is used. */
+import assert from 'node:assert/strict';
+import { randomBytes, sign, verify, createPublicKey, createHash } from 'node:crypto';
+import { envelope } from '../account-transport/oracle.mjs';
+import { proof, link, ZERO } from '../account-service-delivery/fixtures.mjs';
+export const hash = (b) => createHash('sha256').update(b).digest('hex');
+export const json = (v) => new Uint8Array(Buffer.from(JSON.stringify(v)));
+export function query(x, after = 0, limit = 1, changes = {}, key = x.s.privateKey) {
+  const fields = {
+    serviceId: x.authority.pin.serviceId,
+    origin: x.authority.pin.origin,
+    workspace: x.workspace,
+    reader: x.credential,
+    publisher: x.credential,
+    lineage: x.offer.epoch.lineageId,
+    head: x.offer.head,
+    epoch: 1,
+    after,
+    limit,
+    nonce: randomBytes(32).toString('hex'),
+    expires: Date.now() + 60000,
+    ...changes,
+  };
+  const unsigned = ['done/private-read/v2', 2, ...Object.values(fields)];
+  return json([...unsigned, sign(null, json(unsigned), key).toString('hex')]);
+}
+export const read = (x, q) => x.authority.owner.readInbound(x.f.core, q);
+export function pageProof(result, request, x, retained) {
+  assert.equal(result.kind, 'decision', JSON.stringify(result));
+  const bytes = Buffer.from(result.bytes),
+    v = JSON.parse(bytes.toString()),
+    q = JSON.parse(Buffer.from(request).toString());
+  assert.equal(bytes.toString(), JSON.stringify(v));
+  assert.equal(v.length, 7);
+  assert.deepEqual(v.slice(0, 2), ['done/private-read-page/v2', 2]);
+  assert.equal(v[2], hash(request));
+  assert.equal(v[3], retained.length);
+  assert.ok(v[5].length <= q[11]);
+  assert.equal(v[4], q[10] + v[5].length);
+  assert.ok(v[4] <= v[3]);
+  assert.ok(v[4] === v[3] || v[5].length > 0);
+  const key = createPublicKey({
+    key: Buffer.from('302a300506032b6570032100' + x.offer.epoch.acceptancePublicKey, 'hex'),
+    format: 'der',
+    type: 'spki',
+  });
+  assert.ok(verify(null, json(v.slice(0, 6)), key, Buffer.from(v[6], 'hex')));
+  let previous = ZERO;
+  for (let i = 0; i < q[10]; i++) previous = link(retained[i].w.subject, previous);
+  for (const [i, entry] of v[5].entries()) {
+    const original = retained[q[10] + i];
+    assert.deepEqual(Buffer.from(entry[0], 'hex'), envelope(original.w));
+    assert.deepEqual(Buffer.from(entry[1], 'hex'), Buffer.from(original.r.bytes));
+    proof(
+      { kind: 'decision', bytes: Buffer.from(entry[1], 'hex') },
+      x.offer.epoch.acceptancePublicKey,
+      original.w.subject,
+      previous,
+    );
+    previous = link(original.w.subject, previous);
+  }
+  return { next: v[4], through: v[3], count: v[5].length };
+}
diff --git a/test/account-service-inbound/restart.test.mjs b/test/account-service-inbound/restart.test.mjs
new file mode 100644
index 0000000..c2a53cc
--- /dev/null
+++ b/test/account-service-inbound/restart.test.mjs
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { fork } from 'node:child_process';
+import { once } from 'node:events';
+import { ready, inventory } from '../account-service-delivery/fixtures.mjs';
+import { query, read, pageProof } from './oracle.mjs';
+for (const cut of ['verified', 'signed'])
+  test(
+    `service SIGKILL after ${cut} read leaves no writes and retry returns originals`,
+    { timeout: 12000 },
+    async (t) => {
+      const x = await ready(t),
+        w = x.make(),
+        r = await x.call(w),
+        q = query(x);
+      const before = inventory(x),
+        child = fork(
+          new URL('./worker.mjs', import.meta.url),
+          [
+            x.f.path,
+            x.authority.path,
+            JSON.stringify(x.authority.pin),
+            x.authority.key.toString('hex'),
+            cut,
+          ],
+          { stdio: ['ignore', 'ignore', 'pipe', 'ipc'], serialization: 'advanced' },
+        );
+      let errors = '';
+      child.stderr.on('data', (b) => {
+        errors += b;
+      });
+      t.after(() => {
+        if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
+      });
+      const readyMessage = await Promise.race([
+        once(child, 'message'),
+        once(child, 'exit').then(() => {
+          throw Error(errors);
+        }),
+      ]);
+      assert.equal(readyMessage[0].ready, true);
+      let replies = 0;
+      child.on('message', () => {
+        replies++;
+      });
+      const death = once(child, 'exit');
+      child.send({ bytes: q });
+      const [code, signal] = await death;
+      assert.equal(code, null);
+      assert.equal(signal, 'SIGKILL');
+      assert.equal(replies, 0);
+      assert.equal(inventory(x), before);
+      x.f.restart();
+      x.authority.restart();
+      pageProof(await read(x, q), q, x, [{ w, r }]);
+      assert.equal(inventory(x), before);
+    },
+  );
diff --git a/test/account-service-inbound/worker.mjs b/test/account-service-inbound/worker.mjs
new file mode 100644
index 0000000..2d9c711
--- /dev/null
+++ b/test/account-service-inbound/worker.mjs
@@ -0,0 +1,37 @@
+import { AccountCore } from '../../account-service/core.ts';
+import { PrivateAuthority } from '../../account-service/authority.ts';
+import { AcceptanceCustody } from '../../account-service/acceptance.ts';
+const [path, rootPath, pinJSON, keyHex, cut] = process.argv.slice(2),
+  pin = JSON.parse(pinJSON);
+const die = () => process.kill(process.pid, 'SIGKILL');
+const core = new AccountCore(
+  path,
+  { origin: pin.origin, rpId: pin.rpId },
+  {
+    hook(at, op) {
+      if (op === 'read-inbound' && at === 'after-verify' && cut === 'verified') die();
+    },
+  },
+);
+if (cut === 'signed') {
+  const original = AcceptanceCustody.prototype.inboundPage;
+  AcceptanceCustody.prototype.inboundPage = function (...args) {
+    original.apply(this, args);
+    die();
+  };
+}
+const owner = PrivateAuthority.open(rootPath, pin, Buffer.from(keyHex, 'hex'));
+process.on('message', async (input) => {
+  if (input.close) {
+    owner.close();
+    core.close();
+    process.disconnect();
+    return;
+  }
+  try {
+    process.send({ result: await owner.readInbound(core, input.bytes) });
+  } catch (e) {
+    process.send({ error: String(e) });
+  }
+});
+process.send({ ready: true });
