+        continue;
+      }
+      if (!live()) {
+        db.exec('ROLLBACK');
+        return unknown('invalid-request');
+      }
+      issuer.check(auth.seal, s.promotion.request_digest, auth.a.acceptanceKey);
+      const answer = issuer.inboundPage(
+        auth.seal,
+        s.promotion.request_digest,
+        auth.a.acceptanceKey,
+        page,
+      );
