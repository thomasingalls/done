+    stdio: ['ignore', 'pipe', 'pipe'],
+    env,
+  });
+  let timedOut = false,
+    forced,
+    error;
+  const kill = (signal) => {
+    try {
+      process.kill(-child.pid, signal);
+    } catch {}
+  };
+  const timer = setTimeout(() => {
+    timedOut = true;
+    kill('SIGTERM');
+    forced = setTimeout(() => kill('SIGKILL'), 5000);
+  }, timeout);
+  const heartbeat = setInterval(
+    () => console.log(name + ' still running; see ' + name + '.log'),
+    15000,
+  );
