+        "resultHex": "b330231c2f0c266d2f68ca54b6e7a8f2760842f680cd407570be38e9dbbb36fb",
+        "name": "done.b330231c2f0c266d2f68ca54b6e7a8f2"
+      },
+      "negatives": [
+        {
+          "field": "principalId",
+          "scope": {
