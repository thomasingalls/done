+        {
+          "field": "workspaceId",
+          "scope": {
+            "principalId": "principal-é",
+            "workspaceId": "workspace-🙂x",
+            "storeId": "12121212121212121212121212121212"
+          },
+          "name": "done.beccb9c3cb8aa69816f86dd52d5f77ca"
