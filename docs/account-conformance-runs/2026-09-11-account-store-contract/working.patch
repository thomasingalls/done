+    ],
+    [
+      'promotion-contract',
+      testArgs('promotion-contract', ['test/account-promotion-contract/formats.test.mjs']),
+    ],
+    [
+      'ledger-contract',
+      testArgs(
+        'ledger-contract',
+        ['formats', 'controls'].map((n) => 'test/account-ledger-contract/' + n + '.test.mjs'),
+      ),
+    ],
+    [
+      'store-contract',
+      testArgs('store-contract', ['test/account-store-contract/formats.test.mjs']),
+    ],
+    ['store-native', testArgs('store-native', ['test/account-store-contract/native.test.mjs'])],
+    [
+      'counter-contract',
+      testArgs('counter-contract', ['test/account-counter-contract/formats.test.mjs']),
+    ],
+    ['wasm-bridge', ['scripts/check-wasm-seal.mjs']],
+    [
+      'content-native',
+      [
+        'scripts/content/run.mjs',
+        '--case',
+        'C01.byte-replay,C09.unreadable-load',
+        '--output',
+        join(output, 'content-native', 'native'),
+      ],
+    ],
+    [
+      'journal-native',
+      [
+        'scripts/journal/run.mjs',
+        '--case',
+        'C01.synchronous-crash,C09.unreadable,C11.abort-flush,C04.close-and-keys,C04.concurrent-writers,C01.handoff-race',
+        '--output',
+        join(output, 'journal-native', 'native'),
+      ],
+    ],
+    ['typecheck', ['node_modules/typescript/bin/tsc', '-b', '--noEmit']],
+    ['unit', ['node_modules/vitest/vitest.mjs', 'run', '--maxWorkers=2']],
+    ...vectorCommands.map((args, i) => ['vectors-' + String(i + 1).padStart(2, '0'), args]),
+    [
+      'lint',
+      [
+        'node_modules/oxlint/bin/oxlint',
+        'scripts/account-store-contract',
+        'test/account-store-contract',
+        'scripts/account-first-authority/registry.mjs',
+        'test/account-first-authority/registry.test.mjs',
+        'scripts/check-authority-map.mjs',
+      ],
+    ],
+    [
+      'format',
+      [
+        'node_modules/oxfmt/bin/oxfmt',
+        '--check',
+        'scripts/account-store-contract',
+        'test/account-store-contract',
+        'scripts/account-first-authority/registry.mjs',
