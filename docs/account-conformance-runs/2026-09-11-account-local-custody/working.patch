+    }),
+  });
+  for (const [id, state, n] of [
+    ['creating', 'creating', 0],
+    ['reserved', 'creating', 3],
+    ['protected', 'protected', 3],
+  ]) {
+    const value = recordFixture(state, n),
+      values = metadataValues(value);
+    add(
+      'custody-metadata-' + id,
