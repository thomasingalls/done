+  );
+  await h.openCredential(o.scope, o.bytes(o.root), c);
+  report('export-cleanup', {
+    formats,
+    cleanup,
+    controls: ['privateFormat', 'exportCleanup', 'openCleanup'],
+    logicalDisposalOnly: true,
+  });
+});
