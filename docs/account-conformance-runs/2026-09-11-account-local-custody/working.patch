+      resultHex: hex(signature(seed('signing'), signingProbe())),
+    },
+    negatives: [{ seed: '99'.repeat(32), publicKey: hex(publicBytes('signing', '99'.repeat(32))) }],
+  });
+  const peer = '77'.repeat(32);
+  vectors.push({
+    id: 'custody-wrapping-correspondence',
+    kind: 'predicate',
+    signer: null,
+    input: {
