+    id: 'custody-generated-code',
+    kind: 'predicate',
+    signer: null,
+    input: { entropyHex: hex(entropy) },
+    expected: { messageHex: hex(entropy), resultHex: hex(Buffer.from(display)), normalized },
+    negatives: [{ input: '0'.repeat(24) }, { input: 'U'.repeat(25) }, { input: '0'.repeat(26) }],
+  });
