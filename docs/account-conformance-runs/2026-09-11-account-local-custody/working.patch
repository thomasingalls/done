+    );
+  }
+  return {
+    v: 1,
+    scope:
+      'D6 current factor/custody bytes; no PRF enrollment, rotation, rollback or total-loss qualification',
+    inherited: ['device-lock', 'record-format'].map((n) => ({
+      path: `test/vectors/${n}.json`,
+      sha256: createHash('sha256')
+        .update(readFileSync(`test/vectors/${n}.json`))
+        .digest('hex'),
+    })),
+    vectors,
+  };
+}
