+    add(
+      'custody-credential-' + role,
+      'aead',
+      { scope, root, seed: seed(role), value: c },
+      lp(...values),
+      bytes(c.sealed.ct),
+      values,
+    );
+  }
+  vectors.push({
+    id: 'custody-signing-correspondence',
+    kind: 'predicate',
+    signer: null,
+    input: { seed: seed('signing'), publicKey: hex(publicBytes('signing')) },
