+mkdirSync(output, { recursive: true });
+console.log(`Service-custody evidence: ${output}`);
+const walk = (dir) =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? walk(join(dir, e.name)) : [join(dir, e.name)],
+  );
+const files = [
+  ...new Set([
+    ...[
+      'src',
+      'account-protocol',
+      'account-service',
