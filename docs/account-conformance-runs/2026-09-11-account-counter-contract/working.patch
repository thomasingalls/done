+const scripts = {};
+for (const c of ['base', 'equalMac', 'reserve'])
+  scripts[c] = await bundle(c === 'base' ? undefined : c, true);
+const report = (name, v) => {
+  if (process.env.ACCOUNT_REPORT_DIR) {
