+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { load } from './runtime.mjs';
+import {
+  fixture,
+  bytes,
+  hex,
+  json,
+  sourceValues,
+  spoolValues,
+  history,
+  fold,
