diff --git a/infra/apps/done/check.py b/infra/apps/done/check.py
index 5a9789c..335efe7 100644
--- a/infra/apps/done/check.py
+++ b/infra/apps/done/check.py
@@ -118,7 +118,11 @@ assert stream['matches']==[{'path':{'type':'Exact','value':'/account/notificatio
 assert stream['timeouts']=={'request':'0s','backendRequest':'0s'}
 assert ordinary['matches']==[{'path':{'type':'PathPrefix','value':'/'}}]
