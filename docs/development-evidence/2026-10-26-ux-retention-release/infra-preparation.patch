     assert flux['spec']['suspend'] is False, 'Application and public routing are enabled in this desired state'
     assert flux['spec']['path']=='./infra/apps/done'+('/public' if name=='done-public' else '')
+    assert flux['spec']['dependsOn']==([{'name':'infra-core'}] if name=='done' else [{'name':'done'},{'name':'gateway'}]), 'Use current Flux tiers without reviving the retired infra dependency'
 # Compare the enabled Gateway with a temporary baseline omitting only the done patch.
 new=one(render(ROOT/'infra/gateway'),'Gateway','public')
 with tempfile.TemporaryDirectory(prefix='done-gateway-render-') as d:
