-for r in route['spec']['rules']: assert r['backendRefs']==[{'name':'done','port':8080}] and not r.get('filters') and not r.get('retry')
+hsts=[{'type':'ResponseHeaderModifier','responseHeaderModifier':{'set':[{'name':'Strict-Transport-Security','value':'max-age=31536000'}]}}]
+for r in route['spec']['rules']:
+    assert r['backendRefs']==[{'name':'done','port':8080}] and not r.get('retry')
+    assert r.get('filters')==hsts, 'Exactly one host-only HSTS header on ordinary and streaming HTTPS responses'
+
 redirect=one(public,'HTTPRoute','done-http-redirect')
 assert redirect['spec']['rules']==[{'filters':[{'type':'RequestRedirect','requestRedirect':{'scheme':'https','statusCode':301}}]}]
 assert redirect['spec']['parentRefs'][0]['sectionName']=='http'
