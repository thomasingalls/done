  "classificationDefinitions": {
    "constant": {
      "meaning": "acknowledgment, scalar status, fixed summary or ordered token; no list of lifetime positions",
      "notes": "computation can still load/verify history; this is a reply-shape classification, not a speed or safety claim"
    },
    "full-history-aggregate": {
      "meaning": "unpaginated graph grows with retained history; global message guard eventually refuses",
      "notes": "compositionStatus demonstrated in487b; Local compactContent risk is static only"
    },
    "bounded-stream": {
      "meaning": "total messages grow, each recovery page or byte part is bounded",
      "notes": "recovery128KiB pages/128parts, frame64KiBparts; existing overall/entry limits and checks remain"
    },
    "bounded-protocol-read": {
      "meaning": "request/page is bounded by wire/read protocol, not lifetime history",
      "notes": "receiveFetch/Verify include constant inbound summary plus scalar frame counts; payload output is separate stream"
    },
    "operation-sized": {
      "meaning": "array depends on current append/flush work, not every lifetime position",
      "notes": "append returns sequences; flush returns contentReceipts across all pending batches. Existing input/admission/transport guards do not independently prove every aggregate reply fits"
    },
    "membership-sized": {
      "meaning": "devices array depends on roster cardinality",
      "notes": "compositionRoster and sessionCommand(roster); no pagination in this reply; only existing global transport cap"
    },
    "opening-context": {
      "meaning": "narrow opening material includes previous-generation key pairs",
      "notes": "receiver accepts at most128previous pairs; no writing or full recovery records in this result"
    },
    "route-one": {
