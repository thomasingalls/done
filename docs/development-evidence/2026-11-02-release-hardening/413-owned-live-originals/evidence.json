{
  "phase": 413,
  "slug": "owned-live-originals",
  "title": "Own canonical live originals through verification and encoding",
  "sourceFiles": [
    "src/crdt/accountInbound.ts",
    "src/crdt/inboundRecord.ts",
    "test/inboundLiveOriginals.test.ts",
