+/** CATCH-UP PROBE (scratch only): numeric request log, active only when DONE_CATCHUP_LOG is set. */
+import { appendFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+const file = process.env['DONE_CATCHUP_LOG'];
+export const probeOn = !!file;
+export const probe = (line: Record<string, unknown>): void => {
+  if (!file) return;
+  try {
+    appendFileSync(file, JSON.stringify({ t: Date.now(), ...line }) + '\n');
+  } catch {
+    /* probe only */
+  }
+};
+export const probeTag = (key: string): string =>
+  file && key ? createHash('sha256').update(key).digest('hex').slice(0, 6) : '';
