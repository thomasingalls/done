+  const steps = inspectInboundSteps(records, route, context);
+  try {
+    let next = steps.next();
+    while (!next.done) {
+      await checkpoint();
+      next = steps.next();
+    }
+    return next.value;
+  } finally {
+    steps.return(undefined as never);
