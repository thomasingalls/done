+      }),
+      (steps) => {
+        const runner = createWorkspaceCommandRunner();
+        const seed = createDoc(),
+          root = workspaceUndo(seed, human),
+          empty = new Map<string, RelativeSelection>();
+        runWorkspaceCommand(root, { group: 0, command: { kind: 'initialize' } }, context, empty);
