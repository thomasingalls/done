+        );
+      } finally {
+        await f.doc.close();
+      }
+    }
+    const f = await makeFixture(undefined, 'local-snapshots');
+    try {
+      await master(f.doc).input(insert('A')).accepted;
+      const old = f.retired.at(-1)!;
+      await master(f.doc).input(insert('\ud800')).accepted;
+      expect(old.history.doc.isDestroyed).toBe(true);
+      await master(f.doc).input(insert('B')).accepted;
+      expect(f.doc.read().master).toBe('A\ufffdB');
+    } finally {
+      await f.doc.close();
+    }
+  });
+
+  it('full catch-up comparison refuses corrupted retired content before another append', async () => {
+    const f = await makeFixture(undefined, 'local-snapshots');
+    try {
+      await master(f.doc).input(insert('A')).accepted;
+      const spare = f.retired.at(-1)!,
+        count = f.emitted.length;
+      spare.history.doc.getMap('meta').set('uncovered', 'drift');
+      const ticket = master(f.doc).input(insert('B'));
+      await until(() => f.doc.status.state === 'blocked');
+      expect(f.doc.read().master).toBe('A');
+      expect(f.emitted).toHaveLength(count);
+      expect(spare.history.doc.isDestroyed).toBe(true);
+      f.doc.discardPending();
+      await expect(ticket.accepted).rejects.toHaveProperty('code', 'discarded');
+    } finally {
+      await f.doc.close();
+    }
+  });
+
+  it('generated buffer histories match fresh forks through deletion, grouping, reset and refusal', async () => {
+    const actions = fc.array(
+      fc.record({
+        kind: fc.constantFrom(
+          'insert',
+          'delete',
+          'undo',
+          'redo',
+          'remote',
+          'metadata',
+          'retry',
+          'discard',
+          'noop',
+          'unicode',
+          'sliced',
+        ),
+        n: fc.integer({ min: 0, max: 20 }),
+      }),
+      { minLength: 15, maxLength: 35 },
+    );
+    await fc.assert(
+      fc.asyncProperty(actions, async (generated) => {
+        const a = await makeFixture(undefined, 'local-handoff'),
+          b = await makeFixture(undefined, 'local-snapshots');
+        const prefix = [
+          'insert',
+          'insert',
+          'delete',
+          'undo',
+          'redo',
+          'retry',
+          'discard',
+          'remote',
+          'metadata',
+          'noop',
+        ];
+        try {
+          for (const step of [...prefix.map((kind) => ({ kind, n: 1 })), ...generated]) {
+            const outputs = [];
+            for (const f of [a, b]) {
+              const text = f.doc.read().master,
+                at = Math.min(step.n, text.length);
+              if (
+                ['insert', 'delete', 'retry', 'discard', 'noop', 'unicode', 'sliced'].includes(
+                  step.kind,
+                )
+              ) {
+                if (step.kind === 'retry' || step.kind === 'discard') {
+                  f.refuse();
+                  f.fail();
+                }
+                const inserted =
+                  step.kind === 'unicode'
+                    ? '\u{1f600}'
+                    : step.kind === 'sliced'
+                      ? 'q'.repeat(1001)
+                      : step.kind === 'noop'
+                        ? ''
+                        : 'x';
+                const action =
+                  step.kind === 'delete' ? { name: 'backspace' as const } : insert(inserted);
+                const ticket = master(f.doc).input(action, selection(at));
+                if (step.kind === 'retry' || step.kind === 'discard') {
+                  await until(() => f.doc.status.state === 'blocked');
+                  expect(f.doc.read().master).toBe(text);
+                  if (step.kind === 'discard') {
+                    f.doc.discardPending();
+                    await expect(ticket.accepted).rejects.toHaveProperty('code', 'discarded');
+                    outputs.push('discarded');
+                    continue;
+                  }
+                  const calls = f.preparations.length;
+                  f.doc.retry();
+                  await ticket.accepted;
+                  expect(f.preparations).toHaveLength(calls);
+                }
+                outputs.push((await ticket.accepted).revision);
+              } else if (step.kind === 'remote') {
+                await f.doc.receive(
+                  remote(f.doc, (d) => d.getText('master').insert(d.getText('master').length, 'R')),
+                ).accepted;
+                outputs.push('remote');
+              } else
+                outputs.push(
+                  (
+                    await f.doc.command(
+                      step.kind === 'metadata'
+                        ? { kind: 'device-label', name: 'device' + step.n }
+                        : { kind: step.kind as 'undo' | 'redo' },
+                    ).accepted
+                  ).value,
+                );
+            }
+            expect(outputs[1]).toEqual(outputs[0]);
+            expect(b.doc.read()).toEqual(a.doc.read());
+            expect(master(b.doc).read()).toEqual(master(a.doc).read());
+            expect(b.doc.status.revision).toBe(a.doc.status.revision);
+          }
+          const replay = createDoc();
+          try {
+            for (const bytes of [...b.disk, ...b.wal]) applyUpdate(replay, bytes);
+            expect(replay.getText('master').toString()).toBe(b.doc.read().master);
+          } finally {
+            replay.destroy();
+          }
+        } finally {
+          await a.doc.close();
+          await b.doc.close();
+        }
+        expect(b.owned.every((x) => x.state.history.doc.isDestroyed)).toBe(true);
+      }),
+      { seed: 171510, numRuns: 60 },
+    );
+  }, 30000);
+});
diff --git a/test/historyRetirement.test.ts b/test/historyRetirement.test.ts
new file mode 100644
index 00000000..68cf590e
--- /dev/null
+++ b/test/historyRetirement.test.ts
@@ -0,0 +1,147 @@
+// @vitest-environment node
+import { it, expect } from 'vitest';
+import { Y, createHistoryDoc, workspaceUndo } from '../src/crdt/yjs';
+import {
+  createWorkspacePreparation,
+  type PreparedWorkspaceState,
+  type PreparationScope,
+} from '../src/crdt/workspacePreparation';
+
+const fixture = () => {
+  const head = { kind: 'local' as const, job: {}, slice: 0, revision: 0, writer: 71 };
+  let verified = 0;
+  const owner = createWorkspacePreparation({ head: () => head, verifiedRevision: () => verified });
+  const states: PreparedWorkspaceState[] = [],
+    scopes: PreparationScope[] = [];
+  const fresh = () => {
+    const history = workspaceUndo(createHistoryDoc(), {});
+    history.doc.clientID = head.writer;
+    const state = { history, selections: new Map(), group: 1, value: true };
+    states.push(state);
+    return state;
+  };
+  const prepare = (state = fresh()) => {
+    head.job = {};
+    const context = owner.issue();
+    owner.prepare(
+      context,
+      new Uint8Array([1]),
+      128,
+      (_ctx, _input, scope) => {
+        scopes.push(scope);
+        scope.ownState(state);
+        return { update: new Uint8Array([0, 0]) };
+      },
+      () => true,
+    );
+    return { context, state };
+  };
+  const adopt = (p: ReturnType<typeof prepare>) => {
+    head.revision++;
+    const state = owner.adopt(p.context, () => true);
+    verified = head.revision;
+    return state;
+  };
+  return {
+    owner,
+    head,
+    states,
+    scopes,
+    fresh,
+    prepare,
+    adopt,
+    async close() {
+      await owner.close();
+      for (const s of states) {
+        s.history.destroy();
+        s.history.doc.destroy();
+      }
+    },
+  };
+};
+
+it('history retirement permits one exact previous transfer and rejects active foreign duplicate or alias states', async () => {
+  const f = fixture(),
+    other = fixture();
+  try {
+    const a = f.prepare();
+    f.adopt(a);
+    expect(() => f.owner.retire(a.state)).toThrow(/cannot be retired/);
+    f.owner.finish(a.context);
+    const b = f.prepare();
+    f.adopt(b);
+    expect(() => f.owner.retire(f.fresh())).toThrow(/cannot be retired/);
+    const foreign = other.prepare();
+    other.adopt(foreign);
+    expect(() => f.owner.retire(foreign.state)).toThrow(/cannot be retired/);
+    expect(() => f.owner.retire({ ...a.state })).toThrow(/cannot be retired/);
+    f.owner.retire(a.state);
+    expect(() => f.owner.retire(a.state)).toThrow(/cannot be retired/);
+    f.owner.finish(b.context);
+    const c = f.prepare(a.state);
+    expect(c.state).toBe(a.state);
+    f.adopt(c);
+    expect(() => f.owner.retire(c.state)).toThrow(/cannot be retired/);
+    f.owner.retire(b.state);
+    f.owner.finish(c.context);
+    const d = f.prepare(b.state);
+    f.adopt(d);
+    f.owner.finish(d.context);
+    expect(a.state.history.doc.isDestroyed).toBe(false);
+    expect(b.state.history.doc.isDestroyed).toBe(false);
+  } finally {
+    await f.close();
+    await other.close();
+  }
+});
+
+it('retired histories resist stale callbacks before during and after reownership', async () => {
+  const f = fixture();
+  try {
+    const a = f.prepare();
+    f.adopt(a);
+    f.owner.finish(a.context);
+    const old = f.scopes[0]!;
+    const b = f.prepare();
+    f.adopt(b);
+    f.owner.retire(a.state);
+    expect(() => old.ownState(a.state)).toThrow(/already owned/);
+    expect(a.state.history.doc.isDestroyed).toBe(false);
+    f.owner.finish(b.context);
+    const c = f.prepare(a.state);
+    const lease = f.owner.borrow(c.context);
+    expect(() => old.ownState(a.state)).toThrow(/already owned/);
+    expect(a.state.history.doc.isDestroyed).toBe(false);
+    f.owner.discard(c.context);
+    expect(a.state.history.doc.isDestroyed).toBe(false);
+    lease.release();
+    expect(a.state.history.doc.isDestroyed).toBe(true);
+    expect(() => old.ownState(b.state)).toThrow(/already owned/);
+    expect(b.state.history.doc.isDestroyed).toBe(false);
+    await f.owner.close();
+    expect(() => f.owner.retire(b.state)).toThrow(/closed/);
+  } finally {
+    await f.close();
+  }
+});
+
+it('retirement does not let a new wrapper reacquire or destroy the real retired document', async () => {
+  const f = fixture();
+  try {
+    const a = f.prepare();
+    f.adopt(a);
+    f.owner.finish(a.context);
+    const b = f.prepare();
+    f.adopt(b);
+    f.owner.retire(a.state);
+    f.owner.finish(b.context);
+    expect(() => f.prepare({ ...a.state })).toThrow(/already owned/);
+    expect(a.state.history.doc.isDestroyed).toBe(false);
+    const next = f.prepare(a.state);
+    f.adopt(next);
+    f.owner.finish(next.context);
+    expect(a.state.history.doc).toBeInstanceOf(Y.Doc);
+  } finally {
+    await f.close();
+  }
+});
