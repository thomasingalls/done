+import type { BatchTiming } from './batchWindow';
+
+/** Opt-in experiment until the measured candidate and focused guards pass. */
+export function accountBatchPolicy(value: string | undefined): {
+  publication?: BatchTiming;
+  localFlush?: BatchTiming;
+} {
+  if (value === undefined || value === '' || value === 'reference') return {};
+  const match = /^(publication|coordinated)-(1000|2000)$/.exec(value);
+  if (!match) throw Error('Invalid VITE_ACCOUNT_BATCH');
+  const timing = Object.freeze({ quietMs: 300, maxMs: Number(match[2]) });
+  return Object.freeze({ publication: timing, ...(match[1] === 'coordinated' ? { localFlush: timing } : {}) });
+}
