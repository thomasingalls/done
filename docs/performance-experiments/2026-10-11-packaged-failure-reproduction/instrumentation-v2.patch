+/** FLAKE-PROBE (scratch only): numeric request log, active only when DONE_FLAKE_LOG is set. */
+import { appendFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+const file = process.env['DONE_FLAKE_LOG'];
+export const flakeOn = !!file;
+export const flake = (line: Record<string, unknown>): void => {
+  if (!file) return;
+  try {
+    appendFileSync(file, JSON.stringify({ t: Date.now(), pid: process.pid, ...line }) + '\n');
+  } catch {
+    /* probe only */
+  }
+};
+export const flakeTag = (token: string | undefined): string =>
+  file && token ? createHash('sha256').update(token).digest('hex').slice(0, 6) : '';
+export const flakeUnlimited = process.env['DONE_FLAKE_UNLIMITED'] === '1';
