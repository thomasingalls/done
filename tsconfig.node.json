{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "account-service",
    "vite.config.ts",
    "vite",
    "playwright.config.ts",
    "playwright.latency.config.ts",
    "playwright.private-migration.config.ts",
    "playwright.local-startup.config.ts",
    "playwright.app-upgrades.config.ts",
    "playwright.storage-compatibility.config.ts"
  ]
}
