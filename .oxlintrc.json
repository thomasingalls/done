{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Deliberately dialed back to bug-catchers only for the remediation phase
  // (2026-08-28): style, pedantic, perf and type-aware rules were noise that
  // kept the composite gate from ever reaching the evidence suite. Lint is
  // opt-in and not part of `pnpm check`.
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // Filed under correctness by oxlint, but style in substance:
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    // Immutable source snapshots and deliberately faulty counterexamples are evidence, not active code.
    "docs/account-conformance-runs/**",
    "docs/performance-experiments/**",
    "docs/development-evidence/2026-10-23-sidebar-overflow/reproduction/playwright.firefox.config.ts",
    "docs/development-evidence/2026-10-23-sidebar-cut-background/reproduction/playwright.sidebar-firefox.config.ts",
    "docs/product-design/2026-10-23-goals-context/editor-assets/editor-study.js",
    "docs/development-evidence/2026-11-02-release-hardening/488-bounded-fixture-status/regression-controls.mjs",
    "docs/development-evidence/2026-11-02-release-hardening/494-maintained-producer-fixture/grow.spec.ts",
    "docs/development-evidence/2026-11-02-release-hardening/498-session-fixture/grow.spec.ts",
    "docs/development-evidence/2026-11-02-release-hardening/500-offline-fixture/grow.spec.ts",
    "dist/**",
    "playwright-report/**",
    "test-results/**",
    "relay/dist/**",
    "relay/test/**"
  ]
}
